-- Create vulnerable stored procedure for user authentication
CREATE PROCEDURE AuthenticateUser
    @Username NVARCHAR(50),
    @Password NVARCHAR(50)
AS
BEGIN
    DECLARE @SQL NVARCHAR(1000)
    -- Fixed the concatenation issue by converting varbinary to string
    SET @SQL = 'SELECT UserID, Username, SecurityLevel FROM Users WHERE Username = ''' + @Username + ''' AND PasswordHash = ''' + CONVERT(NVARCHAR(32), HASHBYTES('MD5', @Password), 2) + ''''
    EXEC (@SQL)
END
GO

