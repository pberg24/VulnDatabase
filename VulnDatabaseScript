-- Create a table-valued function
CREATE FUNCTION GetUserInfo(@UserID INT)
RETURNS @UserInfo TABLE (
    Username NVARCHAR(50),
    Department NVARCHAR(50),
    SecurityLevel INT
)
AS
BEGIN
    -- Direct insert instead of using INSERT EXEC
    INSERT INTO @UserInfo (Username, Department, SecurityLevel)
    SELECT Username, Department, SecurityLevel 
    FROM Users 
    WHERE UserID = @UserID
    
    RETURN
END
GO

