-- Create vulnerable procedure for project access
CREATE PROCEDURE GetProjectDetails
    @ProjectID NVARCHAR(10),
    @UserID INT
AS
BEGIN
    DECLARE @SecurityLevel INT
    DECLARE @SQL NVARCHAR(1000)
   
    -- Get user's security level
    SELECT @SecurityLevel = SecurityLevel FROM Users WHERE UserID = @UserID
   
    -- Vulnerable procedure that doesn't properly enforce access controls
    IF @SecurityLevel >= 2
    BEGIN
        SET @SQL = 'SELECT p.ProjectName, p.Budget, p.Status, u.Username as Manager
                   FROM Projects p
                   JOIN Users u ON p.ManagerID = u.UserID
                   WHERE p.ProjectID = ' + @ProjectID
        EXEC (@SQL)
    END
    ELSE
    BEGIN
        PRINT 'Insufficient privileges'
    END
END
