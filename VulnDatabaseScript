-- Drop existing roles if they exist
IF DATABASE_PRINCIPAL_ID('LowLevelRole') IS NOT NULL
BEGIN
    -- Remove members first
    DECLARE @RoleMembers TABLE (MemberName NVARCHAR(128))
    INSERT INTO @RoleMembers
    SELECT dp.name
    FROM sys.database_role_members drm
    JOIN sys.database_principals dp ON drm.member_principal_id = dp.principal_id
    WHERE drm.role_principal_id = DATABASE_PRINCIPAL_ID('LowLevelRole')
    
    DECLARE @MemberName NVARCHAR(128)
    DECLARE member_cursor CURSOR FOR SELECT MemberName FROM @RoleMembers
    OPEN member_cursor
    FETCH NEXT FROM member_cursor INTO @MemberName
    WHILE @@FETCH_STATUS = 0
    BEGIN
        EXEC sp_droprolemember 'LowLevelRole', @MemberName
        FETCH NEXT FROM member_cursor INTO @MemberName
    END
    CLOSE member_cursor
    DEALLOCATE member_cursor
    
    DROP ROLE LowLevelRole
END
GO

